# Modelo de variáveis de ambiente. NÃO coloque senhas reais aqui.
# Uso:  cp .env.example .env   e depois ajuste os valores no .env
# O arquivo .env real está no .gitignore e nunca deve ir para o GitHub.

# --- API ---
PORT=3000
DB_HOST=db
DB_USER=app
DB_PASSWORD=troque-esta-senha
DB_NAME=loja
REDIS_HOST=redis
REDIS_PORT=6379

# --- MySQL (usada só pelo container do banco, na primeira inicialização) ---
MYSQL_ROOT_PASSWORD=troque-a-senha-root
